{
  "1": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "input.mp4",
      "force_rate": 24,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 360,
      "skip_first_frames": 0,
      "select_every_nth": 1,
      "format": "None"
    },
    "_meta": {
      "title": "Clip (24 fps, up to 15 s)"
    }
  },
  "15": {
    "class_type": "ImageScaleToMaxDimension",
    "inputs": {
      "image": [
        "1",
        0
      ],
      "upscale_method": "area",
      "largest_size": 960
    },
    "_meta": {
      "title": "Long side 960 px"
    }
  },
  "2": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "rt_detr_v4-x-hgnet_fp16.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "RT-DETR v4 person detector"
    }
  },
  "3": {
    "class_type": "RTDETR_detect",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "image": [
        "15",
        0
      ],
      "threshold": 0.5,
      "class_name": "person",
      "max_detections": 1
    },
    "_meta": {
      "title": "Find the performer"
    }
  },
  "4": {
    "class_type": "InstantHMRLoader",
    "inputs": {
      "model_file": "instanthmr_medium.safetensors"
    },
    "_meta": {
      "title": "InstantHMR"
    }
  },
  "5": {
    "class_type": "InstantHMRPredict",
    "inputs": {
      "instanthmr_model": [
        "4",
        0
      ],
      "image": [
        "15",
        0
      ],
      "bboxes": [
        "3",
        0
      ],
      "fov": 0.0,
      "batch_size": 32
    },
    "_meta": {
      "title": "One MHR body per frame"
    }
  },
  "14": {
    "class_type": "SAM3DBody_Smooth",
    "inputs": {
      "mhr_pose_data": [
        "5",
        0
      ],
      "strength": 1.0,
      "method": "gaussian",
      "window": 7,
      "rotation_threshold_degrees": 30.0
    },
    "_meta": {
      "title": "Steady motion"
    }
  },
  "6": {
    "class_type": "BodyDoubleFit",
    "inputs": {
      "mhr_pose_data": [
        "14",
        0
      ]
    },
    "_meta": {
      "title": "Line each body up with its person"
    }
  },
  "8": {
    "class_type": "SAM3DBody_Render",
    "inputs": {
      "pose_data": [
        "6",
        0
      ],
      "width": 0,
      "height": 0,
      "render_style": "scail",
      "render_style.radius_m": 0.022,
      "render_style.hand_style": "dwpose",
      "render_style.face_style": "disabled",
      "render_style.person_palette_falloff": 0.6
    },
    "_meta": {
      "title": "SCAIL pose on black"
    }
  },
  "10": {
    "class_type": "SAM3DBody_Loader",
    "inputs": {
      "model_file": "sam_3d_body_dinov3_int8_convrot.safetensors"
    },
    "_meta": {
      "title": "MHR rig for the skinned GLB"
    }
  },
  "13": {
    "class_type": "SAM3DBody_Render",
    "inputs": {
      "pose_data": [
        "6",
        0
      ],
      "width": 0,
      "height": 0,
      "background": [
        "15",
        0
      ],
      "render_style": "scail",
      "render_style.radius_m": 0.022,
      "render_style.hand_style": "dwpose",
      "render_style.face_style": "disabled",
      "render_style.person_palette_falloff": 0.6
    },
    "_meta": {
      "title": "SCAIL skeleton over the picture (Skeleton look)"
    }
  },
  "20": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sam3.1_multiplex_fp16.safetensors"
    },
    "_meta": {
      "title": "SAM 3.1"
    }
  },
  "21": {
    "class_type": "SAM3_Detect",
    "inputs": {
      "model": [
        "20",
        0
      ],
      "image": [
        "15",
        0
      ],
      "threshold": 0.4,
      "refine_iterations": 2,
      "individual_masks": false,
      "bboxes": [
        "3",
        0
      ]
    },
    "_meta": {
      "title": "Each person's whole outline (inside their box)"
    }
  },
  "22": {
    "class_type": "GrowMask",
    "inputs": {
      "mask": [
        "21",
        0
      ],
      "expand": 2,
      "tapered_corners": true
    },
    "_meta": {
      "title": "Outline, 2 px out"
    }
  },
  "30": {
    "class_type": "LoadMoGeModel",
    "inputs": {
      "model_name": "moge_2_vitl_normal_fp16.safetensors"
    },
    "_meta": {
      "title": "MoGe-2"
    }
  },
  "31": {
    "class_type": "MoGeInference",
    "inputs": {
      "moge_model": [
        "30",
        0
      ],
      "image": [
        "15",
        0
      ],
      "resolution_level": 9,
      "fov_x_degrees": 0.0,
      "batch_size": 4,
      "force_projection": true,
      "apply_mask": false,
      "refine_steps": 0
    },
    "_meta": {
      "title": "The picture's geometry"
    }
  },
  "32": {
    "class_type": "MoGeRender",
    "inputs": {
      "moge_geometry": [
        "31",
        0
      ],
      "output": "normal_opengl"
    },
    "_meta": {
      "title": "Normals"
    }
  },
  "33": {
    "class_type": "MoGeRender",
    "inputs": {
      "moge_geometry": [
        "31",
        0
      ],
      "output": "depth"
    },
    "_meta": {
      "title": "Depth (near is bright)"
    }
  },
  "40": {
    "class_type": "BodyDoubleLook",
    "inputs": {
      "image": [
        "15",
        0
      ],
      "mask": [
        "22",
        0
      ],
      "look": "holo",
      "normals": [
        "32",
        0
      ],
      "depth": [
        "33",
        0
      ],
      "skeleton": [
        "13",
        0
      ],
      "feather": 1.5
    },
    "_meta": {
      "title": "Every person's double in the look"
    }
  },
  "7": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": [
        "40",
        0
      ],
      "frame_rate": 24,
      "loop_count": 0,
      "filename_prefix": "fuobe/body-double",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": false,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true
    },
    "_meta": {
      "title": "Result"
    }
  },
  "9": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": [
        "8",
        0
      ],
      "frame_rate": 24,
      "loop_count": 0,
      "filename_prefix": "fuobe/body-double-pose",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": false,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true
    },
    "_meta": {
      "title": "Pose video"
    }
  },
  "11": {
    "class_type": "BuildPoseFile",
    "inputs": {
      "pose_data": [
        "6",
        0
      ],
      "sam3d_body_model": [
        "10",
        0
      ],
      "format": "glb",
      "format.mesh_style": "body_mesh",
      "format.mesh_style.bone_vis": "off",
      "format.mesh_style.shader": "default",
      "format.bone_smooth_window": 0,
      "fps": 24.0,
      "camera_translation": "absolute",
      "track_index": -1
    },
    "_meta": {
      "title": "Animated skinned body GLB"
    }
  },
  "12": {
    "class_type": "SaveGLB",
    "inputs": {
      "mesh": [
        "11",
        0
      ],
      "filename_prefix": "fuobe/body-double"
    },
    "_meta": {
      "title": "Motion capture"
    }
  }
}
