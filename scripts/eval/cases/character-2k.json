        "images": [
          "fixtures/character/drawn-face-2.png"
        ]
      },
      "prompts": [
        {
          "id": "direction",
          "text": "keep the walk and the timing; the character wears the same clothes as in the picture"
        }
      ],
      "references": "local/genjutsu/character.png",
      "metrics": [
        "identity",
        "background",
        "temporal"
      ],
      "submit": {
        "route": "/api/genjutsu",
        "body": {
          "engine": "{{engine}}",
          "mode": "character",
          "modelId": "{{modelId}}",
          "prompt": "{{prompt}}",
          "references": [
