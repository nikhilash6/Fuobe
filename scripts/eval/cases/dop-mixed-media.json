{
  "$schema": "./case.schema.json",
  "suite": "dop-mixed-media",
  "title": "Fuobe DoP · Mixed Media effects against Kling 2.5 Turbo (blind)",
  "description": "Generated by scripts/eval/gen-cases.mjs from the research files; edit the generator, not this file. The first suite to run once you have paid keys. 8 of DoP's 32 Mixed Media effects on your start frame (local/dop/start.png, a person on a bridge), in the cloud, rated blind: the preset as it ships (Fuobe Mixed Media draws the still in the look, then Fuobe DoP animates it) against the preset's words on Kling 2.5 Turbo, its cloud default before build plan O9. The demo engine runs the Original only, to check the suite.",
  "original": [
    "fuobe-dop"
  ],
  "kind": "video",
  "recipe": "motion",
  "runFirst": "paid-keys",
  "decides": "Fuobe DoP stays the cloud default for DoP's 32 Mixed Media effects unless it clearly loses this blind comparison: in one cloud run with at least 6 blind ratings per case, Kling 2.5 Turbo takes at least two thirds of all non-tie ratings and more than half of them in at least 6 of the 8 cases. Then the default goes back to Kling 2.5 Turbo, in a reviewed code change (src/lib/catalog/dop.ts); anything less keeps Fuobe DoP.",
  "targets": {
    "cloud": {
      "models": [
        "fuobe-dop"
      ],
      "params": {
        "duration": 5
      }
    },
    "demo": {
      "models": [
        "fuobe-dop"
      ],
      "params": {
        "duration": 5
      }
    }
  },
