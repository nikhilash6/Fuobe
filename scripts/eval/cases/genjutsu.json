      }
    },
    {
      "id": "genjutsu/restyle",
      "title": "Restyle: the clip in your look",
      "models": {
        "open": ["fuobe-genjutsu-restyle"],
        "cloud": ["fuobe-genjutsu-restyle"],
        "demo": ["fuobe-genjutsu-restyle"]
      },
      "variantModels": {
        "partner": {
          "cloud": ["kling-o3-4k-edit"]
        }
      },
      "inputs": {
        "video": "local/genjutsu/dance.mp4",
        "images": ["local/genjutsu/style.png"]
      },
      "demoInputs": {
        "video": "samples/demo-portrait.mp4",
        "images": ["fixtures/references/warm-1.png"]
      },
      "prompts": [
        {
          "id": "look",
          "text": "the same scene as a warm hand-painted animation"
        }
      ],
      "references": "local/genjutsu/style.png",
      "metrics": ["temporal", "style", "clip"],
      "submit": {
        "route": "/api/genjutsu",
        "body": {
          "engine": "{{engine}}",
          "mode": "restyle",
          "modelId": "{{modelId}}",
          "look": {
            "kind": "custom",
            "images": ["{{inputs.images.0}}"],
            "words": "{{prompt}}"
          },
          "source": "{{source:inputs.video}}",
          "seed": "{{seed}}",
          "requestId": "{{requestId}}"
        }
      }
    },
    {
      "id": "genjutsu/group",
      "title": "Group swap: two characters, each taking over the person named",
      "engines": ["open"],
      "models": {
        "open": ["oss-h3-group-swap"]
      },
      "inputs": {
        "video": "local/genjutsu/duo.mp4",
        "images": ["local/genjutsu/character.png", "local/genjutsu/character2.png"]
      },
      "metrics": ["temporal", "identity", "clip"],
      "submit": {
        "route": "/api/genjutsu",
        "body": {
          "engine": "{{engine}}",
          "modelId": "{{modelId}}",
          "source": "{{source:inputs.video}}",
          "seed": "{{seed}}",
          "requestId": "{{requestId}}",
          "mode": "character",
          "references": ["{{inputs.images.0}}", "{{inputs.images.1}}"],
          "range": {
            "start": 0,
            "end": 6
          },
          "quality": "720p",
          "character": {
            "people": [
              {
                "role": "the person on the left"
              },
              {
                "role": "the person on the right"
              }
            ]
          }
        }
      }
    },
    {
      "id": "genjutsu/group-one-by-one",
