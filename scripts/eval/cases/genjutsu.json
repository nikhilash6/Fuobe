      "inputs": {
        "video": "local/genjutsu/street.mp4",
        "images": ["local/genjutsu/object.png"]
      },
      "demoInputs": {
        "video": "samples/demo-landscape.mp4",
        "images": ["fixtures/palette.png"]
      },
      "prompts": [
        {
          "id": "swap",
          "text": "the car on the left"
        }
      ],
      "submit": {
        "route": "/api/genjutsu",
        "body": {
          "engine": "{{engine}}",
          "mode": "swap",
          "modelId": "{{modelId}}",
          "target": "type",
          "subject": "{{prompt}}",
          "references": ["{{inputs.images.0}}"],
          "source": "{{source:inputs.video}}",
          "seed": "{{seed}}",
          "requestId": "{{requestId}}"
        }
      }
    },
