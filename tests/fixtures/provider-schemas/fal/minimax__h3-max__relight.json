            "description": "Inference duration in seconds, when available.",
            "title": "Timings"
          },
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "The relighted video."
          }
        },
        "required": [
          "video",
          "seed"
        ],
        "title": "RelightOutput",
        "type": "object",
        "x-fal-order-properties": [
          "video",
          "seed",
          "timings"
        ]
      },
