          "video_url",
          "reference_image_url",
          "resolution",
          "aspect_ratio",
          "seed",
          "enable_safety_checker",
          "sync_mode"
        ]
      },
      "H3MaxRelightOutput": {
        "properties": {
          "seed": {
            "description": "Base seed for reproducing the generation.",
