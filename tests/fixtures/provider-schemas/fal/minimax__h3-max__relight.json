  },
  "info": {
    "description": "Change the lighting of an existing video. Provide a source video (up to 15 seconds) and a sphere render that shows the target lighting: its color, direction and shadow softness. The model describes the source scene, reads the light from the sphere, and regenerates the video with that lighting while keeping the subjects, setting, motion and camera. The source is converted to 24 fps and the output matches its length (at least about 2.3 seconds). Choose 480p, 768p (default), 1080p or 2K (1080p and 2K are refined from 768p) and an aspect ratio (16:9 by default, or adaptive). Safety checking is enabled by default.",
    "title": "Queue OpenAPI for minimax/h3-max/relight",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Generate",
      "category": "video-to-video",
      "documentationUrl": "https://fal.ai/models/minimax/h3-max/relight/api",
      "endpointId": "minimax/h3-max/relight",
      "playgroundUrl": "https://fal.ai/models/minimax/h3-max/relight",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aad7408/RK0vzvak7-_A8Ajqd5pCC.jpg"
    }
  },
  "openapi": "3.1.0",
