  "info": {
    "description": "Generate video with synchronized audio from a prompt and image, video or audio references with H3 Max Turbo. Use up to 9 reference images, 3 reference videos and 3 reference audio clips (2 to 15 seconds each, 15 seconds combined per type, 12 files in total), and refer to them in the prompt as Image 1, Video 1, Audio 1 and so on. To keep a precise order across types, pass them as one ordered reference_conditions list instead. Choose a duration up to 15 seconds (5 by default), 480p, 768p (default) or 1080p, and an aspect ratio (adaptive by default, or 21:9, 16:9, 4:3, 1:1, 3:4, 9:16). Prompt expansion (balanced by default) and safety checking are enabled by default. The response reports the reference tokens used.",
    "title": "Queue OpenAPI for minimax/h3-max-turbo/reference-to-video",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Reference To Video Max Turbo",
      "category": "image-to-video",
      "documentationUrl": "https://fal.ai/models/minimax/h3-max-turbo/reference-to-video/api",
      "endpointId": "minimax/h3-max-turbo/reference-to-video",
      "playgroundUrl": "https://fal.ai/models/minimax/h3-max-turbo/reference-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aadb4ed/Nc_-PFaAPZ_9ikSRTCisF.jpg"
    }
  },
