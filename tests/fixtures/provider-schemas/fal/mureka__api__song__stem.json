            "title": "Audio Url",
            "type": "string"
          },
          "model": {
            "default": "audio-separation-3",
            "description": "Stem-separation model, which determines available stems and MIDI output.",
            "enum": [
              "audio-separation-1",
              "audio-separation-2",
              "audio-separation-3"
            ],
            "title": "Model",
            "type": "string"
          }
        },
        "required": [
          "audio_url"
        ],
        "title": "StemSongInput",
        "type": "object",
