      "category": "audio-to-audio",
      "documentationUrl": "https://fal.ai/models/mureka/api/song/stem/api",
      "endpointId": "mureka/api/song/stem",
      "playgroundUrl": "https://fal.ai/models/mureka/api/song/stem",
