          "model",
          "audio_url"
        ]
      },
      "ApiSongStemOutput": {
        "properties": {
          "midi_zip_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The generated archive of separated MIDI stems, when available.",
            "title": "Midi Zip Url"
          },
          "zip_url": {
            "description": "The generated archive of separated audio stems.",
            "title": "Zip Url",
            "type": "string"
          }
        },
        "required": [
          "zip_url"
        ],
        "title": "StemSongOutput",
        "type": "object",
        "x-fal-order-properties": [
          "zip_url",
          "midi_zip_url"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
