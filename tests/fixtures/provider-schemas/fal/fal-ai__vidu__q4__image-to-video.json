      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      },
      "ViduQ4ImageToVideoInput": {
        "properties": {
          "duration": {
            "default": 5,
            "description": "Duration of the video in seconds (3-16)",
            "maximum": 16,
            "minimum": 3,
            "title": "Duration",
            "type": "integer"
          },
          "enable_safety_checker": {
            "default": true,
            "description": "Authorized callers may set false to request relaxed screening.",
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "image_url": {
            "description": "URL or base64 data URI of the image to use as the first frame. Supports png, jpeg, jpg and webp up to 50 MB.",
            "examples": [
              "https://storage.googleapis.com/falserverless/web-examples/vidu/stylish_woman.webp"
            ],
            "title": "Image Url",
            "type": "string"
          },
          "prompt": {
            "default": "",
            "description": "Text prompt for video generation, max 5000 characters",
            "examples": [
              "The woman turns toward the camera and smiles, then the shot cuts to a close-up as she says: \"Let's go.\""
            ],
            "maxLength": 5000,
            "title": "Prompt",
            "type": "string"
          },
          "resolution": {
            "default": "720p",
            "description": "Output video resolution",
            "enum": [
              "540p",
              "720p",
              "1080p",
              "2K",
              "4K"
            ],
            "title": "Resolution",
            "type": "string"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Random seed for reproducibility. If None, a random seed is chosen.",
            "title": "Seed"
          }
        },
        "required": [
          "image_url"
        ],
        "title": "Q4ImageToVideoRequest",
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "image_url",
          "duration",
          "seed",
          "resolution",
          "enable_safety_checker"
        ]
      },
      "ViduQ4ImageToVideoOutput": {
        "properties": {
          "cover_image": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Image"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cover image of the generated video"
          },
          "seed": {
            "description": "The random seed used for generation",
            "title": "Seed",
            "type": "integer"
          },
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "The generated video from image using the Q4 model",
            "examples": [
              {
                "url": "https://v3b.fal.media/files/b/0a8c9189/n9z3uUDPqmU2msAtqr25-_output.mp4"
              }
            ]
          }
        },
        "required": [
          "video",
          "seed"
        ],
        "title": "Q4ImageToVideoOutput",
        "type": "object",
        "x-fal-order-properties": [
          "video",
          "cover_image",
          "seed"
        ]
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Vidu Q4 Image-to-Video animates a start frame into a high-fidelity clip while preserving the subject and composition of the source image. Prompts can direct motion, camera cuts, and spoken dialogue, and native audio adds synchronized speech and sound effects. It supports durations from 3 to 16 seconds and output from 540p up to 4K.",
    "title": "Queue OpenAPI for fal-ai/vidu/q4/image-to-video",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Vidu Q4 Image to Video API: Generate a video with audio from a first-frame image.",
      "category": "image-to-video",
      "documentationUrl": "https://fal.ai/models/fal-ai/vidu/q4/image-to-video/api",
      "endpointId": "fal-ai/vidu/q4/image-to-video",
      "playgroundUrl": "https://fal.ai/models/fal-ai/vidu/q4/image-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aad2f3f/cmmJZ_YhOejfcxze6tBG6.jpg"
    }
  },
  "openapi": "3.1.0",
  "paths": {
    "/fal-ai/vidu/q4/image-to-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ViduQ4ImageToVideoInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    },
    "/fal-ai/vidu/q4/image-to-video/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViduQ4ImageToVideoOutput"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      }
    },
    "/fal-ai/vidu/q4/image-to-video/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/fal-ai/vidu/q4/image-to-video/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "logs",
            "required": false,
            "schema": {
              "description": "Whether to include logs (`1`) in the response or not (`0`).",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ]
