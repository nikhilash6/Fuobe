  "info": {
    "description": "The OpenAPI schema for the mureka/v9/generate/song queue.",
    "title": "Queue OpenAPI for mureka/v9/generate/song",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Generate complete songs from lyrics or a natural-language description.\n\nLyrics mode gives direct control over the words, while prompt mode creates a\nsong from its requested theme and musical styles. Each result includes a\nreusable song ID and audio URL.",
      "category": "text-to-audio",
      "documentationUrl": "https://fal.ai/models/mureka/v9/generate/song/api",
      "endpointId": "mureka/v9/generate/song",
      "playgroundUrl": "https://fal.ai/models/mureka/v9/generate/song",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aaff182/4drxC0q8eOOC6uSU4RyCQ.jpg"
    }
  },
  "openapi": "3.1.0",
  "paths": {
    "/mureka/v9/generate/song": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/V9GenerateSongInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    },
    "/mureka/v9/generate/song/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V9GenerateSongOutput"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      }
    },
    "/mureka/v9/generate/song/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/mureka/v9/generate/song/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "logs",
            "required": false,
            "schema": {
              "description": "Whether to include logs (`1`) in the response or not (`0`).",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ]
}
