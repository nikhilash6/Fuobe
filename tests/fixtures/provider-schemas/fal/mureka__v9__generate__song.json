      "V9GenerateSongInput": {
        "description": "Input for v9 GenerateSong.",
        "properties": {
          "enable_safety_checker": {
            "default": true,
            "description": "Authorized callers may set false to request relaxed screening.",
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "gender": {
            "anyOf": [
              {
                "enum": [
                  "female",
                  "male"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Preferred vocal gender for lyrics-to-song generation. An uploaded or cloned voice takes precedence.",
            "title": "Gender"
          },
          "lyrics": {
            "anyOf": [
              {
                "maxLength": 5000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Lyrics to sing, up to 5,000 characters. Provide this for lyrics-to-song generation; otherwise provide prompt for prompt-to-song generation.",
            "title": "Lyrics"
          },
          "melody_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Melody ID returned by /files/upload with purpose='melody'. This cannot be combined with prompt, reference_id, or vocal_id.",
            "title": "Melody Id"
          },
          "prompt": {
            "anyOf": [
              {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Describe the desired song, mood, instrumentation, and vocals. Required when lyrics is omitted, up to 2,000 characters. With lyrics, it acts as a music-style control and supports up to 1,024 characters.",
            "examples": [
              "A bright summer love song with a catchy chorus"
            ],
            "title": "Prompt"
          },
          "reference_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Reference-music ID returned by /files/upload with purpose='reference'.",
            "title": "Reference Id"
          },
          "styles": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "pop",
                    "rock",
                    "jazz",
                    "r&b",
                    "edm",
                    "ambient",
                    "folk",
                    "latin",
                    "k-pop",
                    "j-pop",
                    "house",
                    "gospel",
                    "lo-fi"
                  ],
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "One or more musical genres for prompt-to-song generation. This cannot be used when lyrics is provided.",
            "examples": [
              [
                "pop",
                "rock"
              ]
            ],
            "title": "Styles"
          },
          "vocal_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Voice ID returned by /voice/clone.",
            "title": "Vocal Id"
          }
        },
        "title": "GenerateSongV9Input",
        "type": "object",
        "x-fal-order-properties": [
          "lyrics",
          "styles",
          "prompt",
          "gender",
          "reference_id",
          "vocal_id",
          "melody_id",
          "enable_safety_checker"
        ]
      },
      "V9GenerateSongOutput": {
        "description": "A generated audio file and its reusable song identifier.",
        "properties": {
          "audio": {
            "$ref": "#/components/schemas/File",
            "description": "The generated audio file."
          },
          "duration": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Duration of the generated audio in milliseconds, when available.",
            "title": "Duration"
          },
          "lyrics_sections": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/LyricsSection"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Timed lyric sections for the generated audio, when available.",
            "title": "Lyrics Sections"
          },
          "song_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Reusable identifier for this audio. Pass it to endpoints that accept song_id.",
            "title": "Song Id"
          }
        },
        "required": [
          "audio"
        ],
        "title": "GeneratedAudioOutput",
        "type": "object",
        "x-fal-order-properties": [
          "song_id",
          "audio",
          "duration",
          "lyrics_sections"
        ]
      }
    },
    "securitySchemes": {
