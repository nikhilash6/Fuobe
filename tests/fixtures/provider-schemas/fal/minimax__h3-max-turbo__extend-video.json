  "info": {
    "description": "Extend a source video from 1.625 to 60 seconds long, up to 50 MB. Describe what happens next and add 1 to 15 seconds of new footage (5 seconds by default). Choose 480p, 768p (default), 1080p, or 2K. The aspect ratio follows the source by default. Return the full extended video or only the continuation. Optional audio references replace the source soundtrack as the audio reference: up to 3 clips, 2 to 15 seconds each and 15 seconds combined. Prompt expansion and safety checking are enabled by default.",
    "title": "Queue OpenAPI for minimax/h3-max-turbo/extend-video",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Extend a video with new footage based on a prompt, faster.",
      "category": "video-to-video",
      "documentationUrl": "https://fal.ai/models/minimax/h3-max-turbo/extend-video/api",
      "endpointId": "minimax/h3-max-turbo/extend-video",
      "playgroundUrl": "https://fal.ai/models/minimax/h3-max-turbo/extend-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aacaeb7/jUm3mOJpvKxTWhpLVoXCJ.jpg"
    }
  },
