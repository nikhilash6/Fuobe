          "seed": {
            "description": "Seed used for the continuation.",
            "title": "Seed",
            "type": "integer"
          },
          "source": {
            "description": "Source video information: width, height, frame rate, duration, and audio.",
            "title": "Source",
            "type": "object"
          },
          "timings": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Timings",
            "type": "object"
          },
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "The returned video. In 'continuation' mode, it includes the 1.625-second repeat at the start."
          }
        },
        "required": [
          "video",
          "seed",
          "duration",
          "source"
        ],
        "title": "TurboExtendVideoHailuo03Output",
        "type": "object",
        "x-fal-order-properties": [
          "video",
          "seed",
          "duration",
          "source",
          "expanded_prompt",
          "timings"
        ]
      },
