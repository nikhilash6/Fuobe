{
  "components": {
    "schemas": {
      "File": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "File",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      },
      "IdolInput": {
        "properties": {
          "enable_safety_checker": {
            "default": true,
            "description": "Enable safety checking of the input image.",
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "guidance_scale": {
            "default": 3,
            "description": "Classifier-free guidance: how strictly the object follows the image.",
            "maximum": 10,
            "minimum": 0,
            "title": "Guidance Scale",
            "type": "number"
          },
          "image_type": {
            "default": "synthetic",
            "description": "Kind of input image. `synthetic` for renders and generated images (tight crop), `real` for photographs (looser crop).",
            "enum": [
              "synthetic",
              "real"
            ],
            "title": "Image Type",
            "type": "string"
          },
          "image_url": {
            "description": "URL of the image of a single object to convert into a 3D Gaussian splat.",
            "examples": [
              "https://raw.githubusercontent.com/VAST-AI-Research/TripoSplat/36b6deb0a1613e43c6910de441cb57d50352e44a/static/example_inputs/building_stone_house.webp"
            ],
            "title": "Image Url",
            "type": "string"
          },
          "num_gaussians": {
            "default": 262144,
            "description": "Target number of Gaussians in the output splat. Rounded down to a multiple of 32.",
            "maximum": 1048576,
            "minimum": 32768,
            "title": "Num Gaussians",
            "type": "integer"
          },
          "num_inference_steps": {
            "default": 50,
            "description": "Number of sampling steps. Fewer are faster but lose some detail.",
            "maximum": 50,
            "minimum": 1,
            "title": "Num Inference Steps",
            "type": "integer"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Random seed for reproducibility. If None, a random seed is generated.",
            "title": "Seed"
          }
        },
        "required": [
          "image_url"
        ],
        "title": "IdolInput",
        "type": "object",
        "x-fal-order-properties": [
          "image_url",
          "image_type",
          "num_gaussians",
          "num_inference_steps",
          "guidance_scale",
          "seed",
          "enable_safety_checker"
        ]
      },
      "IdolOutput": {
        "properties": {
          "camera": {
            "additionalProperties": {
              "type": "number"
            },
            "description": "Predicted input camera: yaw, pitch (radians), radius, fov (degrees).",
            "title": "Camera",
            "type": "object"
          },
          "model_glb": {
            "$ref": "#/components/schemas/File",
            "description": "Colored point-cloud preview (.glb) of the splat centers, viewable in standard 3D model viewers."
          },
          "model_mesh": {
            "$ref": "#/components/schemas/File",
            "description": "Generated 3D Gaussian splat (.ply)."
          },
          "num_gaussians": {
            "description": "The actual number of Gaussians produced.",
            "title": "Num Gaussians",
            "type": "integer"
          },
          "preprocessed_image": {
            "$ref": "#/components/schemas/Image",
            "description": "The background-removed, cropped image the model saw."
          },
          "seed": {
            "description": "The seed used for generation.",
            "title": "Seed",
            "type": "integer"
          },
          "timings": {
            "additionalProperties": {
              "type": "number"
            },
            "description": "Per-stage timings in seconds.",
            "title": "Timings",
            "type": "object"
          }
        },
        "required": [
          "model_mesh",
          "model_glb",
          "preprocessed_image",
          "camera",
          "num_gaussians",
          "seed",
          "timings"
        ],
        "title": "IdolOutput",
        "type": "object",
        "x-fal-order-properties": [
          "model_mesh",
          "model_glb",
          "preprocessed_image",
          "camera",
          "num_gaussians",
          "seed",
          "timings"
        ]
      },
      "Image": {
        "description": "Represents an image file.",
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The height of the image in pixels.",
            "examples": [
              1024
            ],
            "title": "Height"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The width of the image in pixels.",
            "examples": [
              1024
            ],
            "title": "Width"
          }
        },
        "required": [
          "url"
        ],
        "title": "Image",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The OpenAPI schema for the speridlabs/idol queue.",
    "title": "Queue OpenAPI for speridlabs/idol",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Generate",
      "category": "image-to-3d",
      "documentationUrl": "https://fal.ai/models/speridlabs/idol/api",
      "endpointId": "speridlabs/idol",
      "playgroundUrl": "https://fal.ai/models/speridlabs/idol",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0ab07f87/Z7OKjkqz5tdOAEH34KUOn.jpg"
    }
  },
  "openapi": "3.1.0",
  "paths": {
    "/speridlabs/idol": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdolInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    },
    "/speridlabs/idol/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdolOutput"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      }
    },
    "/speridlabs/idol/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/speridlabs/idol/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "logs",
            "required": false,
            "schema": {
              "description": "Whether to include logs (`1`) in the response or not (`0`).",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ]
}
