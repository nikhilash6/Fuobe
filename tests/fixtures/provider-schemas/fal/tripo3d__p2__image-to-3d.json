{
  "components": {
    "schemas": {
      "File": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "File",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      },
      "ModelUrls": {
        "description": "3D model download URLs",
        "properties": {
          "base_model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Base (untextured) model"
          },
          "fbx": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "FBX format 3D model",
            "title": "FBX"
          },
          "glb": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "GLB format 3D model",
            "title": "GLB"
          },
          "pbr_model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "PBR-textured model",
            "title": "PBR Model"
          }
        },
        "title": "ModelUrls",
        "type": "object",
        "x-fal-order-properties": [
          "glb",
          "fbx",
          "base_model",
          "pbr_model"
        ]
      },
      "P2ImageTo3dInput": {
        "description": "Input for Image to 3D generation using the P2 model.",
        "properties": {
          "auto_size": {
            "default": false,
            "description": "Auto-scale the model to real-world dimensions in meters.",
            "title": "Auto Size",
            "type": "boolean"
          },
          "delight": {
            "default": true,
            "description": "Remove baked-in lighting before texturing with v3.5-20260815.",
            "title": "Delight",
            "type": "boolean"
          },
          "enable_safety_checker": {
            "default": true,
            "description": "Authorized callers may set false to request relaxed screening.",
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "export_orientation": {
            "anyOf": [
              {
                "enum": [
                  "+x",
                  "-x",
                  "-y",
                  "+y"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional forward axis for the exported model.",
            "title": "Export Orientation"
          },
          "export_uv": {
            "default": true,
            "description": "Whether to generate UV coordinates for the model.",
            "title": "Export Uv",
            "type": "boolean"
          },
          "face_limit": {
            "anyOf": [
              {
                "maximum": 50000,
                "minimum": 48,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Maximum number of faces for the generated mesh. Quad meshes support up to 25,000 faces.",
            "title": "Face Limit"
          },
          "image_url": {
            "description": "URL of the input image for 3D model creation.",
            "examples": [
              "https://v3b.fal.media/files/b/zebra/3osHJDI8IZ2wl6sGtEUeB_image.png"
            ],
            "title": "Image Url",
            "type": "string"
          },
          "model_seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Seed for geometry generation reproducibility.",
            "title": "Model Seed"
          },
          "pbr": {
            "default": true,
            "description": "Whether to generate PBR material maps. Enabling PBR also enables textures.",
            "title": "Pbr",
            "type": "boolean"
          },
          "quad": {
            "default": false,
            "description": "Generate quad mesh topology instead of triangles.",
            "title": "Quad",
            "type": "boolean"
          },
          "texture": {
            "default": true,
            "description": "Whether to generate textures for the model.",
            "title": "Texture",
            "type": "boolean"
          },
          "texture_quality": {
            "default": "standard",
            "description": "Texture quality level.",
            "enum": [
              "fast",
              "standard",
              "detailed",
              "extreme"
            ],
            "title": "Texture Quality",
            "type": "string"
          },
          "texture_seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Seed for texture generation reproducibility.",
            "title": "Texture Seed"
          },
          "texture_version": {
            "anyOf": [
              {
                "enum": [
                  "v3.5-20260815",
                  "v3.0-20250812",
                  "v2.5-20250123"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Texture model version. The fast quality requires v3.5-20260815.",
            "title": "Texture Version"
          }
        },
        "required": [
          "image_url"
        ],
        "title": "P2ImageTo3DInput",
        "type": "object",
        "x-fal-order-properties": [
          "image_url",
          "face_limit",
          "texture",
          "pbr",
          "model_seed",
          "texture_seed",
          "texture_quality",
          "texture_version",
          "delight",
          "auto_size",
          "export_uv",
          "export_orientation",
          "quad",
          "enable_safety_checker"
        ]
      },
      "P2ImageTo3dOutput": {
        "description": "Output for Tripo3D generation",
        "properties": {
          "model_mesh": {
            "$ref": "#/components/schemas/File",
            "description": "Generated 3D model file. May be GLB or FBX depending on Tripo output."
          },
          "model_urls": {
            "$ref": "#/components/schemas/ModelUrls",
            "description": "URLs for different 3D model variants.",
            "title": "Model URLs"
          },
          "rendered_image": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Preview render of the generated 3D model."
          },
          "task_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tripo task ID for a generated model. Pass this to rig or rig-check to use the model without uploading it again.",
            "title": "Task Id"
          }
        },
        "required": [
          "model_mesh",
          "model_urls"
        ],
        "title": "Tripo3DOutput",
        "type": "object",
        "x-fal-order-properties": [
          "model_mesh",
          "model_urls",
          "rendered_image",
          "task_id"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The OpenAPI schema for the tripo3d/p2/image-to-3d queue.",
    "title": "Queue OpenAPI for tripo3d/p2/image-to-3d",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "P2 Image To 3D",
      "category": "image-to-3d",
      "documentationUrl": "https://fal.ai/models/tripo3d/p2/image-to-3d/api",
      "endpointId": "tripo3d/p2/image-to-3d",
      "playgroundUrl": "https://fal.ai/models/tripo3d/p2/image-to-3d",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aab5c22/iR7ETXMnNL1Kgpj5bWU5k.jpg"
    }
  },
  "openapi": "3.1.0",
  "paths": {
    "/tripo3d/p2/image-to-3d": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/P2ImageTo3dInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    },
    "/tripo3d/p2/image-to-3d/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/P2ImageTo3dOutput"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      }
    },
    "/tripo3d/p2/image-to-3d/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/tripo3d/p2/image-to-3d/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "logs",
            "required": false,
            "schema": {
              "description": "Whether to include logs (`1`) in the response or not (`0`).",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ]
}
