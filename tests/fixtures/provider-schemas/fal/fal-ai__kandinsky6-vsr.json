  "info": {
    "description": "Kandinsky 6.0 VSR restores and upscales video, recovering fine detail and textures while keeping frames temporally consistent. It works on both generated and real footage, and it pairs naturally with Kandinsky 6.0 Lite and Pro to take drafts to final resolution.",
    "title": "Queue OpenAPI for fal-ai/kandinsky6-vsr",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Upscale",
      "category": "video-to-video",
      "documentationUrl": "https://fal.ai/models/fal-ai/kandinsky6-vsr/api",
      "endpointId": "fal-ai/kandinsky6-vsr",
      "playgroundUrl": "https://fal.ai/models/fal-ai/kandinsky6-vsr",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aac3fba/vaoMsI4kVX1dEpryoFSID.jpg"
    }
  },
