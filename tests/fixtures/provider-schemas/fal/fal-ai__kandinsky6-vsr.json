        ],
        "title": "File",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      },
      "Kandinsky6VsrInput": {
        "properties": {
          "enable_safety_checker": {
            "default": true,
            "description": "Authorized callers may set false to request relaxed screening.",
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "num_inference_steps": {
            "default": 5,
            "description": "The number of denoising steps used for each tile.",
            "maximum": 50,
            "minimum": 2,
            "title": "Num Inference Steps",
            "type": "integer"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The random seed used for the generation process.",
            "title": "Seed"
          },
          "sync_mode": {
            "default": false,
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "title": "Sync Mode",
            "type": "boolean"
          },
          "upscale_factor": {
            "default": 2.25,
            "description": "Total upscale factor applied to the input resolution. One of 2, 2.25 or 4.",
            "enum": [
              2,
              2.25,
              4
            ],
            "title": "Upscale Factor",
            "type": "number"
          },
          "video_url": {
            "description": "The input video to upscale. Clips are resampled to 24fps and capped at 121 frames (~5s). For 2x and 4x upscaling, width and height must be multiples of 16.",
            "examples": [
              "https://storage.googleapis.com/falserverless/example_inputs/seedvr-input.mp4"
            ],
            "title": "Video Url",
            "type": "string"
          }
        },
        "required": [
          "video_url"
        ],
        "title": "Kandinsky6VSRInput",
        "type": "object",
        "x-fal-order-properties": [
          "video_url",
          "upscale_factor",
          "num_inference_steps",
          "seed",
          "sync_mode",
          "enable_safety_checker"
        ]
      },
      "Kandinsky6VsrOutput": {
        "properties": {
          "seed": {
            "description": "The random seed used for the generation process.",
            "title": "Seed",
            "type": "integer"
          },
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "Upscaled video file after processing",
            "examples": [
              {
                "content_type": "video/mp4",
                "url": "https://storage.googleapis.com/falserverless/example_outputs/seedvr-output.mp4"
              }
            ]
          }
        },
        "required": [
          "video",
          "seed"
        ],
        "title": "Kandinsky6VSROutput",
        "type": "object",
        "x-fal-order-properties": [
          "video",
          "seed"
        ]
      },
