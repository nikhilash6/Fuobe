      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      },
      "ViduQ4ReferenceToVideoInput": {
        "properties": {
          "aspect_ratio": {
            "default": "16:9",
            "description": "The aspect ratio of the output video",
            "enum": [
              "16:9",
              "9:16",
              "4:3",
              "3:4",
              "1:1"
            ],
            "title": "Aspect Ratio",
            "type": "string"
          },
          "audio": {
            "default": false,
            "description": "Whether to generate audio (dialogue and sound effects) with the video. When false, the output video is silent.",
            "title": "Audio",
            "type": "boolean"
          },
          "duration": {
            "default": 5,
            "description": "Duration of the video in seconds (3-16)",
            "maximum": 16,
            "minimum": 3,
            "title": "Duration",
            "type": "integer"
          },
          "enable_safety_checker": {
            "default": true,
            "description": "Authorized callers may set false to request relaxed screening.",
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "prompt": {
            "description": "Text prompt for video generation, max 5000 characters. Refer to references by their position in the lists: [@reference_image_1], [@reference_image_2], ... for images and [reference_audio_1], [reference_audio_2], ... for audio clips.",
            "examples": [
              "[@reference_image_1] walks along the beach at sunset holding [@reference_image_2], then turns to the camera and speaks in the voice of [reference_audio_1]."
            ],
            "maxLength": 5000,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "reference_audio_urls": {
            "description": "URLs or base64 data URIs of up to 3 mp3 reference audio clips (3-12 seconds each, max 50 MB) used to keep voices consistent.",
            "items": {
              "type": "string"
            },
            "title": "Reference Audio Urls",
            "type": "array"
          },
          "reference_image_urls": {
            "description": "URLs or base64 data URIs of up to 12 reference images (png, jpeg, jpg, webp) used to keep subjects consistent.",
            "examples": [
              [
                "https://storage.googleapis.com/falserverless/web-examples/vidu/new-examples/reference1.png",
                "https://storage.googleapis.com/falserverless/web-examples/vidu/new-examples/reference2.png"
              ]
            ],
            "items": {
              "type": "string"
            },
            "title": "Reference Image Urls",
            "type": "array"
          },
          "resolution": {
            "default": "720p",
            "description": "Output video resolution",
            "enum": [
              "540p",
              "720p",
              "1080p",
              "2K",
              "4K"
            ],
            "title": "Resolution",
            "type": "string"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Random seed for reproducibility. If None, a random seed is chosen.",
            "title": "Seed"
          }
        },
        "required": [
          "prompt"
        ],
        "title": "Q4ReferenceToVideoRequest",
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "reference_image_urls",
          "reference_audio_urls",
          "duration",
          "seed",
          "aspect_ratio",
          "resolution",
          "audio",
          "enable_safety_checker"
        ]
      },
      "ViduQ4ReferenceToVideoOutput": {
        "properties": {
          "cover_image": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Image"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cover image of the generated video"
          },
          "seed": {
            "description": "The random seed used for generation",
            "title": "Seed",
            "type": "integer"
          },
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "The generated video from references using the Q4 Preview model",
            "examples": [
              {
                "url": "https://v3b.fal.media/files/b/0a8c9189/n9z3uUDPqmU2msAtqr25-_output.mp4"
              }
            ]
          }
        },
        "required": [
          "video",
          "seed"
        ],
        "title": "Q4ReferenceToVideoOutput",
        "type": "object",
        "x-fal-order-properties": [
          "video",
          "cover_image",
          "seed"
        ]
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Vidu Q4 Reference-to-Video builds a scene from your references. You tag up to 12 images (characters, products, objects, locations) and up to 3 voice clips directly in the prompt, and the model keeps each subject and voice consistent throughout the clip. It supports optional native audio with dialogue and sound effects, durations from 3 to 16 seconds, five aspect ratios, and output from 540p up to 4K, which makes it well suited for branded content, character-driven storytelling, and ads.",
    "title": "Queue OpenAPI for fal-ai/vidu/q4/reference-to-video",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Vidu Q4 Preview Reference to Video API: Generate a video from reference images and voices.",
      "category": "image-to-video",
      "documentationUrl": "https://fal.ai/models/fal-ai/vidu/q4/reference-to-video/api",
      "endpointId": "fal-ai/vidu/q4/reference-to-video",
      "playgroundUrl": "https://fal.ai/models/fal-ai/vidu/q4/reference-to-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aad2f50/VDsdBXEj3Vk134o2SqAVM.jpg"
    }
  },
  "openapi": "3.1.0",
  "paths": {
    "/fal-ai/vidu/q4/reference-to-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ViduQ4ReferenceToVideoInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    },
    "/fal-ai/vidu/q4/reference-to-video/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViduQ4ReferenceToVideoOutput"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      }
    },
    "/fal-ai/vidu/q4/reference-to-video/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/fal-ai/vidu/q4/reference-to-video/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "logs",
            "required": false,
            "schema": {
              "description": "Whether to include logs (`1`) in the response or not (`0`).",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ]
