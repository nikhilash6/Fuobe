  "info": {
    "description": "H3 Max Insert Video generates a new scene between two selected points in an existing video. Set a start time and a resume time, describe the new action or provide visual references, and receive a complete video that combines the opening footage, the generated scene, and the remaining source footage.\n",
    "title": "Queue OpenAPI for minimax/h3-max/insert-video",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Inject Video",
      "category": "video-to-video",
      "documentationUrl": "https://fal.ai/models/minimax/h3-max/insert-video/api",
      "endpointId": "minimax/h3-max/insert-video",
      "playgroundUrl": "https://fal.ai/models/minimax/h3-max/insert-video",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aac45ed/CUlIKgQ55O4HiSkSG0OEL.jpg"
    }
  },
