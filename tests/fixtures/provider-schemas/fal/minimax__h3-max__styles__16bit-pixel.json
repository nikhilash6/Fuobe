{
  "components": {
    "schemas": {
      "File": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "File",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      },
      "H3MaxStyles16bitPixelInput": {
        "additionalProperties": false,
        "properties": {
          "aspect_ratio": {
            "default": "16:9",
            "description": "Video aspect ratio for text-only generation. Ignored when image_url is provided.",
            "enum": [
              "21:9",
              "16:9",
              "4:3",
              "1:1",
              "3:4",
              "9:16"
            ],
            "title": "Aspect Ratio",
            "type": "string"
          },
          "duration": {
            "default": 5,
            "description": "Requested video duration in seconds.",
            "maximum": 15,
            "minimum": 5,
            "title": "Duration",
            "type": "integer"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional first-frame image. Use pixel artwork for the most consistent style. When provided, its aspect ratio determines the output canvas.",
            "title": "Image Url"
          },
          "prompt": {
            "description": "Describe the scene, action, camera and sound. The 16-bit pixel style is applied automatically.",
            "examples": [
              "A young bicycle courier pedals through a sunlit flower market. Medium side view, steady tracking camera, measured pedaling. Bicycle chain clicks and gentle market ambience."
            ],
            "maxLength": 49815,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Random seed. Omit to choose one automatically.",
            "title": "Seed"
          }
        },
        "required": [
          "prompt"
        ],
        "title": "PixelInput",
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "image_url",
          "duration",
          "aspect_ratio",
          "seed"
        ]
      },
      "H3MaxStyles16bitPixelOutput": {
        "properties": {
          "seed": {
            "description": "Seed used for this generation.",
            "title": "Seed",
            "type": "integer"
          },
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "Generated 768P pixel-animation video with audio."
          }
        },
        "required": [
          "video",
          "seed"
        ],
        "title": "PixelOutput",
        "type": "object",
        "x-fal-order-properties": [
          "video",
          "seed"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
