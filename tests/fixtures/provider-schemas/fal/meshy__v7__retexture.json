{
  "components": {
    "schemas": {
      "File": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "File",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      },
      "ModelUrls": {
        "description": "3D model files in various formats",
        "properties": {
          "blend": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Blender format 3D model"
          },
          "fbx": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "FBX format 3D model"
          },
          "glb": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "GLB format 3D model"
          },
          "obj": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "OBJ format 3D model"
          },
          "stl": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "STL format 3D model"
          },
          "usdz": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "USDZ format 3D model"
          }
        },
        "title": "ModelUrls",
        "type": "object",
        "x-fal-order-properties": [
          "glb",
          "fbx",
          "obj",
          "usdz",
          "blend",
          "stl"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      },
      "TextureFiles": {
        "description": "Texture files downloaded and uploaded to CDN",
        "properties": {
          "base_color": {
            "$ref": "#/components/schemas/File",
            "description": "Base color texture"
          },
          "metallic": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Metallic texture (PBR)"
          },
          "normal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Normal texture (PBR)"
          },
          "roughness": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Roughness texture (PBR)"
          }
        },
        "required": [
          "base_color"
        ],
        "title": "TextureFiles",
        "type": "object",
        "x-fal-order-properties": [
          "base_color",
          "metallic",
          "normal",
          "roughness"
        ]
      },
      "V7RetextureInput": {
        "description": "Input for 3D Model Retexturing",
        "properties": {
          "enable_original_uv": {
            "default": true,
            "description": "Use the original UV mapping of the model instead of generating new UVs. If the model has no original UV, output quality may be reduced.",
            "title": "Enable Original Uv",
            "type": "boolean"
          },
          "enable_pbr": {
            "default": false,
            "description": "Generate PBR Maps (metallic, roughness, normal) in addition to base color.",
            "title": "Enable Pbr",
            "type": "boolean"
          },
          "enable_safety_checker": {
            "default": true,
            "description": "If set to true, input data will be checked for safety before processing.",
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "image_style_url": {
            "anyOf": [
              {
                "type": "string",
                "ui": {
                  "field": "image"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "2D image to guide the texturing process. Supports .jpg, .jpeg, .png, and .webp formats. Required if text_style_prompt is not provided. If both are provided, image_style_url takes precedence.",
            "max_file_size": 20971520,
            "max_pixels": 178956970,
            "title": "Image Style Url"
          },
          "model_url": {
            "description": "URL or base64 data URI of a 3D model to texture. Supports .glb, .gltf, .obj, .fbx, .stl formats. Can be a publicly accessible URL or data URI with MIME type application/octet-stream.",
            "examples": [
              "https://v3b.fal.media/files/b/penguin/DId89qXLu6BXu09RFAwAV_model.glb"
            ],
            "title": "Model Url",
            "type": "string"
          },
          "text_style_prompt": {
            "anyOf": [
              {
                "maxLength": 800,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Describe your desired texture style using text. Maximum 800 characters. Required if image_style_url is not provided.",
            "examples": [
              "red and black chest"
            ],
            "title": "Text Style Prompt"
          },
          "texture_resolution": {
            "default": "2k",
            "description": "Base color resolution: 2k (2048), 4k (4096), or 8k (8192). 4k and 8k require Meshy 6 or 7. At 8k, PBR maps are 4k and no emission map is generated.",
            "enum": [
              "2k",
              "4k",
              "8k"
            ],
            "title": "Texture Resolution",
            "type": "string"
          }
        },
        "required": [
          "model_url"
        ],
        "title": "RetextureInput",
        "type": "object",
        "x-fal-order-properties": [
          "model_url",
          "text_style_prompt",
          "image_style_url",
          "texture_resolution",
          "enable_original_uv",
          "enable_pbr",
          "enable_safety_checker"
        ]
      },
      "V7RetextureOutput": {
        "description": "Output for 3D Model Retexturing",
        "properties": {
          "image_style_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The image URL used for texturing (if provided)",
            "title": "Image Style Url"
          },
          "model_glb": {
            "$ref": "#/components/schemas/File",
            "description": "Retextured 3D object in GLB format.",
            "examples": [
              {
                "content_type": "model/gltf-binary",
                "file_name": "model.glb",
                "file_size": 4097640,
                "url": "https://v3b.fal.media/files/b/tiger/pU0TtsRTxXM6VnKEYTHSV_model.glb"
              }
            ]
          },
          "model_urls": {
            "$ref": "#/components/schemas/ModelUrls",
            "description": "URLs for different 3D model formats",
            "examples": [
              {
                "fbx": {
                  "content_type": "application/octet-stream",
                  "file_name": "model.fbx",
                  "file_size": 4713692,
                  "url": "https://v3b.fal.media/files/b/rabbit/agzKf8N8zeVnteg72NiF4_model.fbx"
                },
                "glb": {
                  "content_type": "model/gltf-binary",
                  "file_name": "model.glb",
                  "file_size": 4097640,
                  "url": "https://v3b.fal.media/files/b/tiger/pU0TtsRTxXM6VnKEYTHSV_model.glb"
                },
                "obj": {
                  "content_type": "model/obj",
                  "file_name": "model.obj",
                  "file_size": 2964508,
                  "url": "https://v3b.fal.media/files/b/zebra/M5aK_b6vKH7KeGCZoSLq7_model.obj"
                },
                "usdz": {
                  "content_type": "model/vnd.usdz+zip",
                  "file_name": "model.usdz",
                  "file_size": 3886518,
                  "url": "https://v3b.fal.media/files/b/panda/4ItUhLHiH4foEw30qcWZv_model.usdz"
                }
              }
            ]
          },
          "text_style_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The text prompt used for texturing (if provided)",
            "examples": [
              "red and black chest"
            ],
            "title": "Text Style Prompt"
          },
          "texture_urls": {
            "description": "Array of texture file objects",
            "examples": [
              [
                {
                  "base_color": {
                    "content_type": "image/png",
                    "file_name": "texture_0.png",
                    "file_size": 3455709,
                    "url": "https://v3b.fal.media/files/b/zebra/opBcVy7AK-GOlCTUz-_GZ_texture_0.png"
                  }
                }
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/TextureFiles"
            },
            "title": "Texture Urls",
            "type": "array"
          },
          "thumbnail": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Preview thumbnail of the retextured model",
            "examples": [
              {
                "content_type": "image/png",
                "file_name": "preview.png",
                "file_size": 124859,
                "url": "https://v3b.fal.media/files/b/lion/jFrzgIJMbaPQi_4HCEa8u_preview.png"
              }
            ]
          }
        },
        "required": [
          "model_glb",
          "model_urls"
        ],
        "title": "RetextureOutput",
        "type": "object",
        "x-fal-order-properties": [
          "model_glb",
          "thumbnail",
          "model_urls",
          "texture_urls",
          "text_style_prompt",
          "image_style_url"
        ]
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Upload a 3D model (.glb, .gltf, .obj, .fbx or .stl, as a URL or base64 data URI) and describe the texture you want in up to 600 characters, or provide a reference image (.jpg, .jpeg or .png). If both are provided, the image is used. The original UV mapping is kept by default; turn it off to generate new UVs. Optionally generate PBR maps (metallic, roughness, normal) in addition to base color. Returns a GLB model, other available formats, texture files and a preview thumbnail. Safety checking is enabled by default.",
    "title": "Queue OpenAPI for meshy/v7/retexture",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Retexture using Meshy 7 with 2k, 4k, or 8k textures.",
      "category": "3d-to-3d",
      "documentationUrl": "https://fal.ai/models/meshy/v7/retexture/api",
      "endpointId": "meshy/v7/retexture",
      "playgroundUrl": "https://fal.ai/models/meshy/v7/retexture",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aae5f49/fX6rQr3MLd0HuSBFcnFRk.jpg"
    }
  },
  "openapi": "3.1.0",
  "paths": {
    "/meshy/v7/retexture": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/V7RetextureInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    },
    "/meshy/v7/retexture/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V7RetextureOutput"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      }
    },
    "/meshy/v7/retexture/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/meshy/v7/retexture/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "logs",
            "required": false,
            "schema": {
              "description": "Whether to include logs (`1`) in the response or not (`0`).",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ]
}
