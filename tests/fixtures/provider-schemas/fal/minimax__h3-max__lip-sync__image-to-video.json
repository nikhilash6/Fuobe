{
  "components": {
    "schemas": {
      "File": {
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "File",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      },
      "H3MaxLipSyncImageToVideoInput": {
        "properties": {
          "audio_url": {
            "description": "Audio to synchronize the mouth movements to, at least 5 seconds long. Supports up to 15 minutes. The output video matches the supplied audio duration.",
            "title": "Audio Url",
            "type": "string"
          },
          "enable_safety_checker": {
            "default": true,
            "description": "Enable content safety checks.",
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "enable_transcription": {
            "default": true,
            "description": "Transcribe the supplied audio to guide lip synchronization. Turn this off if the audio has a lot of non-word sound, such as music, singing, laughter or noise, which the transcript may turn into words that were never spoken.",
            "title": "Enable Transcription",
            "type": "boolean"
          },
          "image_url": {
            "description": "Image to animate. The aspect ratio must be between 0.4 and 2.5.",
            "title": "Image Url",
            "type": "string"
          },
          "resolution": {
            "default": "768P",
            "description": "Output resolution. Uses the supported aspect ratio nearest the image.",
            "enum": [
              "480P",
              "768P",
              "1080P",
              "2K"
            ],
            "title": "Resolution",
            "type": "string"
          },
          "seed": {
            "anyOf": [
              {
                "maximum": 2147483647,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Random seed; selected randomly if omitted.",
            "title": "Seed"
          }
        },
        "required": [
          "image_url",
          "audio_url"
        ],
        "title": "MaxLipSyncImageInput",
        "type": "object",
        "x-fal-order-properties": [
          "image_url",
          "audio_url",
          "resolution",
          "enable_transcription",
          "seed",
          "enable_safety_checker"
        ]
      },
      "H3MaxLipSyncImageToVideoOutput": {
        "properties": {
          "duration": {
            "description": "Output duration in seconds.",
            "title": "Duration",
            "type": "number"
          },
          "seed": {
            "description": "Random seed used for generation.",
            "title": "Seed",
            "type": "integer"
          },
          "timings": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Timing breakdown in seconds. 'inference' is the DiT denoising time on the GPU backend, summed over every window this request generated. Null on routes that do not report backend timings.",
            "title": "Timings"
          },
          "video": {
            "$ref": "#/components/schemas/File",
            "description": "Lip-synced video with the supplied soundtrack."
          }
        },
        "required": [
          "video",
          "seed",
          "duration"
        ],
        "title": "LipSyncOutput",
        "type": "object",
        "x-fal-order-properties": [
          "video",
          "seed",
          "duration",
          "timings"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
