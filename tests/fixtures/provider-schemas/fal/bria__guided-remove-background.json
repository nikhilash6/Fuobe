{
  "components": {
    "schemas": {
      "GuidedRemoveBackgroundInput": {
        "properties": {
          "autocrop": {
            "default": false,
            "description": "Tighten the output canvas to the kept content.",
            "title": "Autocrop",
            "type": "boolean"
          },
          "image_url": {
            "default": "https://labs-assets.bria.ai/api-examples/guided-remove-background/yoga_studio_input.jpg",
            "description": "Source image as a public URL, a base64 data URI (data:image/png;base64,...) or raw base64-encoded image bytes.",
            "examples": [
              "https://labs-assets.bria.ai/api-examples/guided-remove-background/yoga_studio_input.jpg"
            ],
            "title": "Image Url",
            "type": "string"
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional. Plain words for how to change the default cutout of the photo's obvious subject: add something ('the person with the mat and the plant'), drop something ('the woman at her desk without the lamp') or narrow it ('only the chair'). Everything kept is the original pixels with a new alpha channel. Leave it empty for the plain cutout of the obvious subject.",
            "examples": [
              "the person with the mat and the plant"
            ],
            "title": "Prompt"
          },
          "sync_mode": {
            "default": false,
            "description": "\n            If true, the function waits for the image to be generated and uploaded\n            before returning, so the image is returned directly (base64) instead of\n            via the CDN. Increases latency.\n        ",
            "title": "Sync Mode",
            "type": "boolean"
          }
        },
        "title": "GuidedRemoveBackgroundInput",
        "type": "object",
        "x-fal-order-properties": [
          "image_url",
          "prompt",
          "autocrop",
          "sync_mode"
        ]
      },
      "GuidedRemoveBackgroundOutput": {
        "properties": {
          "image": {
            "$ref": "#/components/schemas/Image",
            "description": "The original photo with a new alpha channel: the obvious subject, adjusted by the prompt (RGBA PNG)."
          }
        },
        "required": [
          "image"
        ],
        "title": "GuidedRemoveBackgroundOutput",
        "type": "object",
        "x-fal-order-properties": [
          "image"
        ]
      },
      "Image": {
        "description": "Represents an image file.",
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The mime type of the file.",
            "examples": [
              "image/png"
            ],
            "title": "Content Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The name of the file. It will be auto-generated if not provided.",
            "examples": [
              "z9RV14K95DvU.png"
            ],
            "title": "File Name"
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The size of the file in bytes.",
            "examples": [
              4404019
            ],
            "title": "File Size"
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The height of the image in pixels.",
            "examples": [
              1024
            ],
            "title": "Height"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The width of the image in pixels.",
            "examples": [
              1024
            ],
            "title": "Width"
          }
        },
        "required": [
          "url"
        ],
        "title": "Image",
        "type": "object",
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ]
      },
      "QueueStatus": {
        "properties": {
          "cancel_url": {
            "description": "The cancel url.",
            "type": "string"
          },
          "logs": {
            "additionalProperties": true,
            "description": "The logs.",
            "type": "object"
          },
          "metrics": {
            "additionalProperties": true,
            "description": "The metrics.",
            "type": "object"
          },
          "queue_position": {
            "description": "The queue position.",
            "type": "integer"
          },
          "request_id": {
            "description": "The request id.",
            "type": "string"
          },
          "response_url": {
            "description": "The response url.",
            "type": "string"
          },
          "status": {
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ],
            "type": "string"
          },
          "status_url": {
            "description": "The status url.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "request_id"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "description": "Fal Key",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
