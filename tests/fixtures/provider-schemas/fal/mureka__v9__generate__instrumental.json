  "info": {
    "description": "The OpenAPI schema for the mureka/v9/generate/instrumental queue.",
    "title": "Queue OpenAPI for mureka/v9/generate/instrumental",
    "version": "1.0.0",
    "x-fal-metadata": {
      "about": "Generate one or more instrumental tracks without vocals.\n\nDescribe the music with a prompt or guide generation with a previously\nuploaded instrumental reference.",
      "category": "text-to-audio",
      "documentationUrl": "https://fal.ai/models/mureka/v9/generate/instrumental/api",
      "endpointId": "mureka/v9/generate/instrumental",
      "playgroundUrl": "https://fal.ai/models/mureka/v9/generate/instrumental",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0aaff1b0/QdgRyEDZMctEvdrsBhiPQ.jpg"
    }
  },
  "openapi": "3.1.0",
  "paths": {
    "/mureka/v9/generate/instrumental": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/V9GenerateInstrumentalInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    },
    "/mureka/v9/generate/instrumental/requests/{request_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V9GenerateInstrumentalOutput"
                }
              }
            },
            "description": "Result of the request."
          }
        }
      }
    },
    "/mureka/v9/generate/instrumental/requests/{request_id}/cancel": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Whether the request was cancelled successfully.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The request was cancelled."
          }
        }
      }
    },
    "/mureka/v9/generate/instrumental/requests/{request_id}/status": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "Request ID",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "logs",
            "required": false,
            "schema": {
              "description": "Whether to include logs (`1`) in the response or not (`0`).",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStatus"
                }
              }
            },
            "description": "The request status."
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "servers": [
    {
      "url": "https://queue.fal.run"
    }
  ]
}
