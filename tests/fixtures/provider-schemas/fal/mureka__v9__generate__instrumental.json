      "V9GenerateInstrumentalInput": {
        "description": "Input for v9 GenerateInstrumental.",
        "properties": {
          "enable_safety_checker": {
            "default": true,
            "description": "Authorized callers may set false to request relaxed screening.",
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "instrumental_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Instrumental ID returned by /files/upload with purpose='instrumental'. Provide exactly one of instrumental_id or prompt.",
            "title": "Instrumental Id"
          },
          "prompt": {
            "anyOf": [
              {
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Description of the desired instrumental. Provide exactly one of prompt or instrumental_id.",
            "title": "Prompt"
          }
        },
        "title": "GenerateInstrumentalV9Input",
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "instrumental_id",
          "enable_safety_checker"
        ]
      },
      "V9GenerateInstrumentalOutput": {
        "description": "A generated audio file and its reusable song identifier.",
        "properties": {
          "audio": {
            "$ref": "#/components/schemas/File",
            "description": "The generated audio file."
          },
          "duration": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Duration of the generated audio in milliseconds, when available.",
            "title": "Duration"
          },
          "lyrics_sections": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/LyricsSection"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Timed lyric sections for the generated audio, when available.",
            "title": "Lyrics Sections"
          },
          "song_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Reusable identifier for this audio. Pass it to endpoints that accept song_id.",
            "title": "Song Id"
          }
        },
        "required": [
          "audio"
        ],
        "title": "GeneratedAudioOutput",
        "type": "object",
        "x-fal-order-properties": [
          "song_id",
          "audio",
          "duration",
          "lyrics_sections"
        ]
      }
