{
  "1": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "input.mp4",
      "force_rate": 0,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1,
      "format": "None",
      "meta_batch": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Green-screen clip, decoded framesPerBatch frames per pass"
    }
  },
  "2": {
    "class_type": "VHS_BatchManager",
    "inputs": {
      "frames_per_batch": 32
    },
    "_meta": {
      "title": "Meta batch: re-queue every framesPerBatch frames (memory stays flat)"
    }
  },
  "3": {
    "class_type": "VHS_VideoInfo",
    "inputs": {
      "video_info": [
        "1",
        3
      ]
    },
    "_meta": {
      "title": "Source frame rate"
    }
  },
  "4": {
    "class_type": "LoadCorridorKeyModel",
    "inputs": {
      "precision": "auto",
      "use_refiner": true,
      "mixed_precision": true
    },
    "_meta": {
      "title": "CorridorKey (v1.0 weights, downloaded on first run)"
    }
  },
  "5": {
    "class_type": "ChromaKeyPrepass",
    "inputs": {
      "image": [
        "1",
        0
      ],
      "screen_color": "green",
      "threshold": 0.3,
      "softness": 0.1,
      "erode": 2,
      "blur": 5
    },
    "_meta": {
      "title": "Coarse alpha hint from the screen colour"
    }
  },
  "6": {
    "class_type": "CorridorKeyGreenscreen",
    "inputs": {
      "ck_model": [
        "4",
        0
      ],
      "image": [
        "1",
        0
      ],
      "alpha_hint": [
        "5",
        0
      ],
      "despill_strength": 1,
      "refiner_scale": 1,
      "auto_despeckle": true,
      "despeckle_size": 400,
      "input_is_linear": false
    },
    "_meta": {
      "title": "CorridorKey: alpha, despilled foreground, straight RGBA"
    }
  },
  "7": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": [
        "6",
        2
      ],
      "audio": [
        "1",
        2
      ],
      "frame_rate": [
        "3",
        5
      ],
      "loop_count": 0,
      "filename_prefix": "fuobe/video-key-corridorkey",
      "format": "video/webm",
      "pix_fmt": "yuva420p",
      "crf": 20,
      "profile": "4444",
      "save_metadata": true,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true,
      "meta_batch": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Cut-out: transparent WebM (yuva420p), or ProRes 4444 with alpha (format video/ProRes, profile 4444)"
    }
  },
  "8": {
    "class_type": "MaskToImage",
    "inputs": {
      "mask": [
        "6",
        0
      ]
    },
    "_meta": {}
  },
  "9": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": [
        "8",
        0
      ],
      "frame_rate": [
        "3",
        5
      ],
      "loop_count": 0,
      "filename_prefix": "fuobe/video-key-corridorkey",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": true,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true,
      "meta_batch": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Alpha mask MP4"
    }
  },
  "10": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": [
        "6",
        1
      ],
      "audio": [
        "1",
        2
      ],
      "frame_rate": [
        "3",
        5
      ],
      "loop_count": 0,
      "filename_prefix": "fuobe/video-key-corridorkey",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": true,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true,
      "meta_batch": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Clean foreground MP4 (green spill removed)"
    }
  },
  "11": {
    "class_type": "SaveImageAdvanced",
    "inputs": {
      "images": [
        "6",
        2
      ],
      "filename_prefix": "fuobe/video-key-corridorkey",
      "format": "exr",
      "format.bit_depth": "16-bit float",
      "format.input_color_space": "sRGB"
    },
    "_meta": {
      "title": "OpenEXR frames with alpha (scene-linear, half float)"
    }
  }
}
